@page "/"

<PageTitle>Pokémon Type Chart</PageTitle>

<div class="tc-header">
    <h1>Pokémon Type Chart</h1>
    <p class="tc-subtitle">Select a game, attacking type, and defending type(s) to see how effective the move will
        be.</p>
</div>

<div class="tc-card">
    <h2 class="tc-section-title">Game</h2>
    <select class="tc-game-select"
            @onchange="OnGameChanged"
            value="@_selectedGameId">
        @foreach (var group in TypeChartService.GameGroups)
        {
            <optgroup label="@group.Name">
                @foreach (var game in group.Games)
                {
                    <option value="@game.Id">@game.DisplayName</option>
                }
            </optgroup>
        }
    </select>
</div>

<div class="tc-card">
    <h2 class="tc-section-title">Attacking Type</h2>
    <div class="tc-type-grid">
        @foreach (var type in ValidTypes)
        {
            <button class="tc-type-btn @(type == _attackType
                                           ? "tc-type-selected"
                                           : "")"
                    style="background-color: @TypeChartService.TypeColors[type]"
                    @onclick="() => SelectAttackType(type)">
                @type
            </button>
        }
    </div>
</div>

<div class="tc-card">
    <h2 class="tc-section-title">Defending Types</h2>
    <div class="tc-defend-row">
        <div class="tc-defend-col">
            <h3 class="tc-defend-label">Primary</h3>
            <div class="tc-type-grid">
                @foreach (var type in ValidTypes)
                {
                    <button class="tc-type-btn @(type == _defendType1
                                                   ? "tc-type-selected"
                                                   : "") @(type == _defendType2
                                                             ? "tc-type-disabled"
                                                             : "")"
                            style="background-color: @TypeChartService.TypeColors[type]"
                            disabled="@(type == _defendType2)"
                            @onclick="() => SelectDefendType1(type)">
                        @type
                    </button>
                }
            </div>
        </div>
        <div class="tc-defend-col">
            <h3 class="tc-defend-label">Secondary <span class="tc-optional">(optional)</span></h3>
            <div class="tc-type-grid">
                <button class="tc-type-btn tc-type-none @(_defendType2 == null
                                                            ? "tc-type-selected"
                                                            : "")"
                        @onclick="() => _defendType2 = null">
                    None
                </button>
                @foreach (var type in ValidTypes)
                {
                    <button class="tc-type-btn @(type == _defendType2
                                                   ? "tc-type-selected"
                                                   : "") @(type == _defendType1
                                                             ? "tc-type-disabled"
                                                             : "")"
                            style="background-color: @TypeChartService.TypeColors[type]"
                            disabled="@(type == _defendType1)"
                            @onclick="() => SelectDefendType2(type)">
                        @type
                    </button>
                }
            </div>
        </div>
    </div>
</div>

@if (_attackType.HasValue && _defendType1.HasValue)
{
    var eff = TypeChartService.GetEffectiveness(_attackType.Value, _defendType1.Value, _defendType2, CurrentEra);
    var info = GetResultInfo(eff);
    var defenderLabel = _defendType2.HasValue
        ? $"{_defendType1}/{_defendType2}"
        : $"{_defendType1}";

    <div class="tc-card tc-result-card @info.CssClass">
        <div class="tc-result-multiplier">@info.Multiplier</div>
        <div class="tc-result-label">@info.Label</div>
        <p class="tc-result-description">@GetDescription(_attackType.Value, defenderLabel, info)</p>
    </div>
}
